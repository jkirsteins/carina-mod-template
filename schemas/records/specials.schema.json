{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Records added to specials (carina-records/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "carina-records/1"
    },
    "catalog": {
      "const": "specials"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$",
            "description": "<namespace>.<snake_case>: the namespace is your package id with '-' read as '_'"
          },
          "app": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
            "description": "snake_case key"
          },
          "space": {
            "type": "array",
            "items": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "minItems": 6,
            "maxItems": 6
          },
          "cost": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 6,
            "maxItems": 6
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
              "description": "snake_case key"
            },
            "uniqueItems": true
          },
          "indestructible": {
            "type": "boolean"
          },
          "playerAvailable": {
            "type": "boolean"
          },
          "strategic": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "nameKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
            "description": "text key"
          }
        },
        "required": [
          "key",
          "app",
          "space",
          "cost",
          "excludes",
          "indestructible",
          "playerAvailable",
          "strategic",
          "nameKey"
        ],
        "additionalProperties": false
      }
    }
  }
}
