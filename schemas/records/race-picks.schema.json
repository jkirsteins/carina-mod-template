{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Records added to race-picks (carina-records/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "carina-records/1"
    },
    "catalog": {
      "const": "race-picks"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$",
            "description": "<namespace>.<snake_case>: the namespace is your package id with '-' read as '_'"
          },
          "group": {
            "enum": [
              "trait",
              "government",
              "special"
            ]
          },
          "trait": {
            "anyOf": [
              {
                "enum": [
                  "population",
                  "farming",
                  "industry",
                  "science",
                  "money",
                  "shipDefense",
                  "shipAttack",
                  "groundCombat",
                  "spying"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "anyOf": [
              {
                "enum": [
                  "penalty",
                  "bonus",
                  "bigBonus"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "cost": {
            "type": "integer"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "valueUnit": {
            "anyOf": [
              {
                "enum": [
                  "pct",
                  "halfFood",
                  "halfBc",
                  "perWorker",
                  "points"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "government": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
                "description": "snake_case key"
              },
              {
                "type": "null"
              }
            ]
          },
          "exclusiveWith": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
              "description": "snake_case key"
            },
            "uniqueItems": true
          },
          "nameKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
            "description": "text key"
          },
          "descKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
            "description": "text key"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/effect"
            }
          }
        },
        "required": [
          "key",
          "group",
          "trait",
          "level",
          "cost",
          "value",
          "valueUnit",
          "government",
          "exclusiveWith",
          "nameKey",
          "descKey"
        ],
        "additionalProperties": false
      }
    }
  },
