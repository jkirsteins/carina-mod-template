{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Records added to armor (carina-records/1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "carina-records/1"
    },
    "catalog": {
      "const": "armor"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$",
            "description": "<namespace>.<snake_case>: the namespace is your package id with '-' read as '_'"
          },
          "app": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
            "description": "snake_case key"
          },
          "mult": {
            "type": "integer",
            "minimum": 1
          },
          "troopBonus": {
            "type": "integer",
            "minimum": 0
          },
          "strategicHp": {
            "type": "integer",
            "minimum": 0
          },
          "negatesAp": {
            "type": "boolean"
          },
          "nameKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
            "description": "text key"
          }
        },
        "required": [
          "key",
          "app",
          "mult",
          "troopBonus",
          "strategicHp",
          "negatesAp",
          "nameKey"
        ],
        "additionalProperties": false
      }
    }
  }
}
